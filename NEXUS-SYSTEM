local targetTasks = {}
local function stopTargetTask(key)
	if targetTasks[key] then task.cancel(targetTasks[key]); targetTasks[key] = nil end
	pcall(function() if GetRoot(plr):FindFirstChild("BreakVelocity") then GetRoot(plr).BreakVelocity:Destroy() end end)
	StopAnim()
end

local function addTargetToggle(key, y, x, w, h, onActivate, onDeactivate)
	local btn = Instance.new("TextButton", TargetPage)
	btn:SetAttribute("langKey", key)
	btn.Size = UDim2.new(0, w, 0, h); btn.Position = UDim2.new(0, x, 0, y)
	btn.Text = T(key); btn.BackgroundColor3 = Color3.fromRGB(55,55,95)
	btn.TextColor3 = Color3.fromRGB(220,220,255); btn.Font = Enum.Font.GothamBold; btn.TextSize = 13
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,8)
	local active = false
	local indicator = Instance.new("Frame", btn)
	indicator.Size = UDim2.new(0, 15, 0, 15); indicator.Position = UDim2.new(1, -20, 0.5, -7)
	indicator.BackgroundColor3 = Color3.fromRGB(255,0,0); Instance.new("UICorner", indicator).CornerRadius = UDim.new(1,0)
	btn.MouseButton1Click:Connect(function()
		active = not active
		if active then
			indicator.BackgroundColor3 = Color3.fromRGB(0,255,150)
			if onActivate then onActivate(btn) end
		else
			indicator.BackgroundColor3 = Color3.fromRGB(255,0,0)
			if onDeactivate then onDeactivate(btn) end
			stopTargetTask(key)
			if key == "target_view" and workspace.CurrentCamera.CameraSubject ~= plr.Character.Humanoid then
				workspace.CurrentCamera.CameraSubject = plr.Character.Humanoid
				btn.Text = T("target_view")
			end
		end
	end)
	return btn
end

