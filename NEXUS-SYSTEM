local function addButton(parent, key, y, isToggle, callback)
	local btn = Instance.new("TextButton", parent)
	btn:SetAttribute("langKey", key)
	btn.Size = UDim2.new(0.9, 0, 0, 38); btn.Position = UDim2.new(0.05, 0, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(40,40,70); btn.TextColor3 = Color3.fromRGB(220,220,255)
	btn.Font = Enum.Font.GothamBold; btn.Text = T(key); btn.TextSize = 15
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,10)
	if isToggle then
		local indicator = Instance.new("Frame", btn)
		indicator.Size = UDim2.new(0, 20, 0, 20); indicator.Position = UDim2.new(1, -30, 0.5, -10)
		indicator.BackgroundColor3 = Color3.fromRGB(255,0,0); Instance.new("UICorner", indicator).CornerRadius = UDim.new(1,0)
		btn.MouseButton1Click:Connect(function()
			if indicator.BackgroundColor3 == Color3.fromRGB(255,0,0) then
				indicator.BackgroundColor3 = Color3.fromRGB(0,255,150)
				callback(true, btn)
			else
				indicator.BackgroundColor3 = Color3.fromRGB(255,0,0)
				callback(false, btn)
			end
		end)
	else
		btn.MouseButton1Click:Connect(function() callback(btn) end)
	end
	return btn
end

