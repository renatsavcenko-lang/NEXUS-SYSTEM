-- LANG
local function addLangButton(key, y, langCode)
	local btn = Instance.new("TextButton", LangPage)
	btn:SetAttribute("langKey", key)
	btn.Size = UDim2.new(0.8, 0, 0, 50); btn.Position = UDim2.new(0.1, 0, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(45,45,75); btn.TextColor3 = Color3.fromRGB(220,220,255)
	btn.Font = Enum.Font.GothamBold; btn.Text = T(key); btn.TextSize = 18
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0,12)
	btn.MouseButton1Click:Connect(function() lang = langCode; refreshAllTexts() end)
end
addLangButton("lang_en", 10, "EN")
addLangButton("lang_ru", 70, "RU")

